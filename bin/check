#!/bin/sh
# Fast deterministic checks. Add --browser for the real client/browser suite.
set -eu
cd "$(dirname "$0")/.."
export RUBOCOP_CACHE_ROOT="${RUBOCOP_CACHE_ROOT:-$PWD/tmp/rubocop-cache}"
bundle exec rake
bundle exec rake example > /dev/null
for check in "$@"; do
  case "$check" in
    --browser) bin/check-browser ;;
    --package) bundle exec ruby scripts/check_package_host.rb ;;
    *) echo "Unknown check: $check" >&2; exit 2 ;;
  esac
done
